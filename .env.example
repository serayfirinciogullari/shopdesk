# --- Model (birincil: Groq üzerinden gpt-oss) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Geliştirme ve eval: küçük model. Canlı demoda openai/gpt-oss-120b.
MODEL=openai/gpt-oss-20b

# --- Yedek model (Groq kotası dolarsa: Gemini, OpenAI uyumlu endpoint) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash

# --- Sağlayıcı sırası (isteğe bağlı) ---
# Doluysa MODEL/GEMINI_MODEL yerine bu sıra kullanılır; 429/5xx'te sıradakine geçilir.
# Groq'ta kota model başına ayrı: iki Groq modeli = iki ayrı kota. Canlı demo için:
# MODEL_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash
MODEL_CHAIN=

# --- Canlı demo koruması (rate limit) ---
# IP başına: RATE_LIMIT_WINDOW_MIN dakikada en fazla RATE_LIMIT_PER_IP mesaj/karar.
RATE_LIMIT_PER_IP=8
RATE_LIMIT_WINDOW_MIN=10
# Tüm site için günlük üst sınır (UTC günü); Groq'un günlük token kotasını korur.
RATE_LIMIT_DAILY=150

# --- Veritabanı (MongoDB Atlas M0) ---
# Örnek: mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=shopdesk
